# ---------------------------------------------------------------------------
# ERP HRM Core — example environment.
# Copy to .env and replace every secret. NEVER commit a real .env.
# ---------------------------------------------------------------------------

APP_ENV=local                     # local | test | staging | production
DEBUG=true
APP_NAME="ERP HRM Core"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-this-is-only-an-example-value-not-for-production

# Async driver is required (asyncpg). Alembic derives its sync URL from this.
DATABASE_URL=postgresql+asyncpg://hrm:hrm@localhost:5433/hrm
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6380/0

# --- Docker host port mappings ----------------------------------------------
# Deliberately NOT 5432/6379: this machine already runs PostgreSQL and Redis,
# and the sibling Accounting stack claims the defaults too. Change only if you
# know the port is free.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=8001

# --- Auth -------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
TRUSTED_HOSTS=["*"]
OPENAPI_ENABLED=true
MAX_REQUEST_BODY_BYTES=2097152
SLOW_REQUEST_MS=1000

# --- Rate limiting (per client IP, sliding window in Redis) -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Payroll ----------------------------------------------------------------
# ROUND_HALF_UP | ROUND_HALF_EVEN | ROUND_DOWN | ROUND_UP | ROUND_CEILING | ROUND_FLOOR
MONEY_ROUNDING=ROUND_HALF_UP
EMPLOYEE_NUMBER_PREFIX=EMP
CONTRACT_NUMBER_PREFIX=CON
PAYROLL_RUN_NUMBER_PREFIX=PR
# Working days assumed in a month when prorating a monthly salary by attendance.
PAYROLL_STANDARD_WORKING_DAYS=22
# GL accounts the payroll journal credits. Must exist in the Accounting module's
# chart of accounts; HRM only ever sends the code as a string.
PAYROLL_BASIC_SALARY_ACCOUNT=6000
PAYROLL_NET_PAYABLE_ACCOUNT=2100
PAYROLL_EMPLOYER_LIABILITY_ACCOUNT=2110

# --- Attendance -------------------------------------------------------------
ATTENDANCE_DEFAULT_GRACE_MINUTES=10
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=0

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=erp-hrm-core
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Seed / bootstrap (local development only) ------------------------------
# If unset, `python -m app.scripts.seed` generates random passwords and prints
# them once to stdout. Never set these in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_HR_MANAGER_PASSWORD=
SEED_PAYROLL_MANAGER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
